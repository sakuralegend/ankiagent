# Mẫu file .env - copy thành ".env" rồi điền giá trị thật vào.
# File .env thật KHÔNG được đưa lên git.

CLAUDE_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
CLAUDE_API_KEY=dien-api-key-gemini-vao-day
CLAUDE_MODEL=gemini-3.5-flash-lite
# (tuỳ chọn) model dự phòng khi model chính hết quota free trong ngày
CLAUDE_FALLBACK_MODELS=gemini-3.1-flash-lite

ANKI_CONNECT_URL=http://127.0.0.1:8765

# (tuỳ chọn nhưng NÊN khai trên VPS) Đường dẫn file kho Anki. Bot mở nó CHỈ-ĐỌC để
# xác nhận việc dọn đã thật sự lên AnkiWeb chưa (QD-34) — thiếu dòng này thì bot vẫn
# chạy, chỉ mất phần kiểm chứng và nó sẽ nói thẳng là "chưa kiểm được".
# Trên VPS (Anki trong Docker, thư mục bind-mount vào /data):
ANKI_COLLECTION=/root/ankiagent/anki-data/User 1/collection.anki2
# 🔴 TRÊN LAPTOP thì khai xong VẪN không đọc được nếu Anki đang MỞ: Anki giữ khoá
# file, SQLite báo `database is locked` kể cả khi mở chế độ chỉ-đọc (đo 10/08/2026,
# đường dẫn `AppData\Roaming\Anki2\User 1\collection.anki2`). Nên trên laptop cửa
# này chỉ chạy được lúc ĐÓNG Anki — đừng đọc `None` thành "sạch", nó là "không biết".

# Giọng đọc từ + câu ví dụ: Yandex SpeechKit (vì sao: đầu anki_tools/audio.py).
# Yandex Cloud -> Service accounts -> quyền ai.speechkit-tts.user -> Create API key.
# Để trống thì thẻ mới TRỐNG TIẾNG (vá sau: python scripts/fix_audio.py --tai rồi --apply).
YANDEX_TTS_API_KEY=
# (tuỳ chọn) giọng — mặc định alena (user nghe so 5 giọng, chốt 18/10/2026)
YANDEX_TTS_VOICE=alena

TELEGRAM_BOT_TOKEN=dien-token-tu-BotFather-vao-day
TELEGRAM_USER_ID=dien-user-id-telegram-cua-ban

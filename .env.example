# Mẫu file .env - copy thành ".env" rồi điền giá trị thật vào.
# File .env thật KHÔNG được đưa lên git.

CLAUDE_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
CLAUDE_API_KEY=dien-api-key-gemini-vao-day
CLAUDE_MODEL=gemini-3.5-flash
# (tuỳ chọn) model dự phòng khi model chính hết quota free trong ngày
CLAUDE_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-flash-lite-latest

ANKI_CONNECT_URL=http://127.0.0.1:8765

# (tuỳ chọn) Âm thanh dự phòng khi OpenRussian lỗi tải mp3 (500): Google Cloud TTS.
# ⚠️ KHÔNG dùng được key Gemini của AI Studio ở trên — phải tạo API key riêng
# trong Google Cloud Console, project đã bật "Cloud Text-to-Speech API".
# Để trống thì bỏ qua phao dự phòng (thẻ lỗi audio sẽ không có tiếng).
GOOGLE_TTS_API_KEY=
# (tuỳ chọn) đổi giọng đọc — mặc định ru-RU-Standard-A (nữ). Nam: ru-RU-Standard-D
GOOGLE_TTS_VOICE=ru-RU-Standard-A

TELEGRAM_BOT_TOKEN=dien-token-tu-BotFather-vao-day
TELEGRAM_USER_ID=dien-user-id-telegram-cua-ban

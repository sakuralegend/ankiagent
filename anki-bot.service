# systemd service cho bot Telegram - tự khởi động cùng VPS, tự restart nếu crash.
# Cài: cp anki-bot.service /etc/systemd/system/ && systemctl daemon-reload && systemctl enable --now anki-bot
[Unit]
Description=Anki Telegram Bot (ankiagent)
After=network-online.target docker.service
Wants=network-online.target
# Truoc 31/07/2026: Restart=always khong kem gioi han => bot chet di chet lai
# co the quay VO HAN ma khong ai biet. Nay khai ro "chet han" = 5 lan khoi dong
# trong 5 phut; cham nguong thi systemd bo cuoc VA goi anki-bot-alert.service
# nhan Telegram cho user (QD-04). Bot crash roi tu len lai thi khong kêu.
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=anki-bot-alert.service

[Service]
Type=simple
WorkingDirectory=/root/ankiagent
ExecStart=/root/ankiagent/venv/bin/python bot.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1
# Cache ngu phap cua BOT nam NGOAI thu muc repo (QD-05). Neu de trong repo thi
# bot ghi vao file do git dang quan => repo ban => `git pull` bo cuoc o lan deploy
# sau (da xay ra 31/07/2026). Hai ben hai cho rieng thi het ket.
Environment=ANKI_GRAMMAR_CACHE=/root/anki-cache/grammar_cache.json

[Install]
WantedBy=multi-user.target
